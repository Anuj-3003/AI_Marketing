# Database (swappable to Postgres later via connection string only — see PROJECT_PLAN.md section 5a)
DATABASE_URL=sqlite:///./app.db

# OpenRouter (single key for all three model tasks)
OPENROUTER_API_KEY=
OPENROUTER_COMPETITOR_MODEL=perplexity/sonar-pro
OPENROUTER_COPY_MODEL=openai/gpt-5
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Meta Ad Library (only active ad source for this demo) — sourced via Adyntel
ADYNTEL_API_KEY=
ADYNTEL_EMAIL=
ADYNTEL_COUNTRY_CODE=US

# Cap on ads fetched per source per competitor (see PROJECT_PLAN.md section 4)
MAX_ADS_PER_SOURCE=

# Google Ads (single-user, no DB row — used by the publish flow, build order step 5)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
